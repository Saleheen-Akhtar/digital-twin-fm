{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm --filter @digital-twin-fm/web run build",
  "installCommand": "pnpm install",
  "outputDirectory": ".next",
  "env": {
    "NEXT_OUTPUT": "standalone",
    "NEXT_PUBLIC_API_URL": "https://dtfm-api-gateway.onrender.com",
    "API_GATEWAY_URL": "https://dtfm-api-gateway.onrender.com",
    "JWT_ACCESS_SECRET": "CHANGE_ME_32plus_chars_before_deploy"
  }
}
